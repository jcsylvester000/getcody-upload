# Copy to .env.local and fill in. Server-only — never prefix with NEXT_PUBLIC_.
CODY_API_KEY=
CODY_API_BASE=https://getcody.ai/api/v1
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Password for the login screen. Required in production; optional for local `npm run dev`.
APP_PASSWORD=
